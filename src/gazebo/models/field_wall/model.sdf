<?xml version="1.0"?>
<sdf version="1.8">
  <model name="reefscape_field_wall">
    <static>true</static>

    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/field_wall.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.16 0.19 1</ambient>
          <diffuse>0.30 0.33 0.38 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/field_wall.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
