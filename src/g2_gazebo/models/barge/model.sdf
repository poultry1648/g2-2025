    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/barge.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.31 0.10 0.10 1</ambient>
          <diffuse>0.62 0.20 0.20 1</diffuse>
        </material>
