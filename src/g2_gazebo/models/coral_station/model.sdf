<?xml version="1.0"?>
<sdf version="1.8">
  <model name="reefscape_coral_station">
    <static>true</static>

    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/coral_station.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>2.0 2.0 1.5</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
