{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROS 2: colcon build (compile_commands)",
      "type": "shell",
      "command": "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "ROS 2: build motor_msgs only",
      "type": "shell",
      "command": "source /opt/ros/jazzy/setup.bash && colcon build --packages-select motor_msgs --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
